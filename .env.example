# Local PostgreSQL from compose.yaml. These defaults are for local development.
POSTGRES_PORT=55432
DATABASE_URL=postgresql://contextcon:contextcon_local@127.0.0.1:55432/contextcon
# Create a separate database before enabling PostgreSQL integration tests.
TEST_DATABASE_URL=postgresql://contextcon:contextcon_local@127.0.0.1:55432/contextcon_test
PORT=3001

# Provisional, configurable demonstration policy. See docs/DECISION_FLOW.md.
RISK_CHALLENGE_THRESHOLD=25
RISK_BLOCK_THRESHOLD=72

# rules, agents, or meko. rules is credential-free.
INVESTIGATION_MODE=rules
INVESTIGATION_TEAM=collective
INVESTIGATION_PROFILE=extended
# off, shadow or enforce. enforce lets analyst-confirmed session patterns block. See docs/DECISION_FLOW.md.
MEMORY_POLICY=off
# meko or local. local is an in-process stand-in for demos without keys; not valid with INVESTIGATION_MODE=meko.
MEMORY_STORE=meko
# Hosted Meko runs through the backend only. Required in meko mode.
MEKO_API_KEY=
MEKO_DATAPACK_ID=
MEKO_RISK_SIGNALS_DATAPACK_ID=
# Covers MCP initialization and the search request.
MEKO_TIMEOUT_MS=12000
MEKO_AUTO_PUBLISH=on

# none, gemini, groq, or ollama. Use Free only on hosted providers.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Blank uses GROQ_MODEL; optionally openai/gpt-oss-120b.
GROQ_INVESTIGATOR_MODEL=
GROQ_JSON_MODE=strict
LLM_OLLAMA_FALLBACK=off
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_MS=8000
