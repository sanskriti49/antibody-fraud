{
  "name": "contextcon-fraud-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/scripts/migrate.ts",
    "simulate": "node --env-file-if-exists=.env --import tsx src/scripts/simulate.ts",
    "verify:meko": "node --env-file-if-exists=.env --import tsx src/scripts/verify-meko.ts",
    "verify:llm": "node --env-file-if-exists=.env --import tsx src/scripts/verify-llm.ts",
    "test": "vitest run",
    "test:postgres": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.postgres.config.ts",
    "memory:work": "node --env-file-if-exists=.env --import tsx src/scripts/memory-work.ts",
    "demo:learn": "node --env-file-if-exists=.env --import tsx src/scripts/learn-demo.ts",
    "demo:signals": "node --env-file-if-exists=.env --import tsx src/scripts/demo-signals.ts",
    "evaluate:ranked": "node --env-file-if-exists=.env --import tsx src/scripts/evaluate-ranked.ts",
    "evaluate:early": "node --env-file-if-exists=.env --import tsx src/scripts/evaluate-early.ts",
    "playbooks:sync": "node --env-file-if-exists=.env --import tsx src/scripts/playbooks-sync.ts",
    "demo:feed": "node --env-file-if-exists=.env --import tsx src/scripts/demo-feed.ts",
    "web:install": "npm --prefix web ci",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.16.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "vite": "7.3.8"
  }
}
